{
  "name": "compliance-saas",
  "version": "0.1.0",
  "private": true,
  "description": "小微企业合规 SaaS - 劳动合规 + 合同审核 + 行业方法论量化引擎",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "parse:docs": "tsx scripts/parse-docs.ts",
    "deploy:cloudbase": "tcb framework deploy",
    "deploy:vercel": "vercel --prod",
    "miniprogram:dev": "echo 'Run `npx @tarojs/cli init miniprogram` then copy from miniprogram-shared/'",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^4.6.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.0.2",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.12.1",
    "next": "14.2.15",
    "next-auth": "5.0.0-beta.22",
    "pdfkit": "^0.19.1",
    "puppeteer-core": "^23.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "unpdf": "^1.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
