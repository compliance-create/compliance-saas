# ====== 应用 ======
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-32-byte-random-string

# ====== 数据库 ======
# 本地开发: SQLite (零配置)
# 生产 CloudBase: PostgreSQL, 替换下面整行
DATABASE_URL="file:./prisma/dev.db"
# 生产示例:
# DATABASE_URL="postgresql://user:pass@host:5432/compliance?schema=public"

# ====== 微信支付 V3 (逐年订阅) ======
WECHAT_PAY_MCH_ID=your-merchant-id
WECHAT_PAY_API_V3_KEY=your-32-char-api-v3-key
WECHAT_PAY_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/wechat/pay/notify
# 公众号 / 网站应用 AppID(用于 PC 扫码登录)
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# 小程序 AppID
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# ====== 套餐 ======
PRICE_ANNUAL_CNY=99800  # 单位:分, 即 ¥998/年
PRICE_CURRENCY=CNY
TRIAL_DAYS=7

# ====== AI (LLM) ======
# 主供应商: GLM (智谱) https://bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 备用: DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认供应商: glm | deepseek
LLM_PROVIDER=glm

# ====== CloudBase(部署时用) ======
TCB_ENV_ID=your-cloudbase-env-id
TCB_SECRET_ID=your-secret-id
TCB_SECRET_KEY=your-secret-key
